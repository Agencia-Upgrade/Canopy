{% extends "layouts/base.twig" %}

{% block content %}
	{% if search_query %}
		{% set title = __('Results for “%s”', 'canopy')|format(search_query|e) %}
		{% set lede = __('Matches in titles and body copy.', 'canopy') %}
		{% set empty = __('No match. Try a shorter word, or go home.', 'canopy') %}
	{% else %}
		{% set title = __('Search', 'canopy') %}
		{% set lede = __('Find a page or post.', 'canopy') %}
		{% set empty = __('Type a word. Results show a title, date, and short excerpt.', 'canopy') %}
	{% endif %}

	{% include 'components/feed.twig' with {
		title: title,
		lede: lede,
		empty: empty,
		empty_link: site.url,
		empty_label: __('Go to the homepage', 'canopy'),
		show_search: true,
		field_id: 'cnp-search-page',
		found_posts: found_posts
	} %}
{% endblock %}
