{# WP fallback and the posts page when a static front is set. #}
{% extends "layouts/base.twig" %}

{% block content %}
	{% include 'components/feed.twig' with {
		title: archive_title|default(__('Blog', 'canopy')),
		lede: __('Writing from the team.', 'canopy'),
		empty: __('No posts yet. Publish one in the dashboard — it will show up here.', 'canopy'),
		empty_link: site.url,
		empty_label: __('Go to the homepage', 'canopy')
	} %}
{% endblock %}
