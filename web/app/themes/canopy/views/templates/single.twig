{% extends "layouts/base.twig" %}

{% block content %}
	<article class="cnp-post">
		{% include 'components/breadcrumbs.twig' %}

		<header class="cnp-post__header">
			<h1 class="cnp-post__title">{{ post.title }}</h1>
			<p class="cnp-post__byline">
				<time class="cnp-post__date" datetime="{{ post.date|date('c') }}">{{ post.date|date('F j, Y') }}</time>
				{% if post.author %}
					<span class="cnp-post__author">{{ __('by %s', 'canopy')|format(post.author.name) }}</span>
				{% endif %}
			</p>
			{% set terms = post.terms('category') %}
			{% if terms %}
				<ul class="cnp-post__terms">
					{% for term in terms %}
						<li><a href="{{ term.link|e('esc_url') }}">{{ term.name }}</a></li>
					{% endfor %}
				</ul>
			{% endif %}
		</header>

		{% if post.thumbnail %}
			<figure class="cnp-post__media">
				<img src="{{ post.thumbnail.src|e('esc_url') }}" alt="{{ post.thumbnail.alt|e }}" width="{{ post.thumbnail.width }}" height="{{ post.thumbnail.height }}">
			</figure>
		{% endif %}

		<div class="cnp-post__content">
			{{ post.content|raw }}
		</div>
	</article>
{% endblock %}
