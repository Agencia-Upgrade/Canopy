{# Optional Motion island. {% embed 'components/reveal.twig' %}{% block reveal %}…{% endblock %}{% endembed %}
   Pass eager / stagger in `with`. A page without this markup never downloads Motion. #}
<div class="cnp-reveal{% if class %} {{ class }}{% endif %}" data-island="reveal"{% if eager %} data-island-eager{% endif %}{% if stagger %} data-reveal-stagger{% endif %}>
	{% block reveal %}{{ content|raw }}{% endblock %}
</div>
