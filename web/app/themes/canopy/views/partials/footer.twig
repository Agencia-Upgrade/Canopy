<footer class="cnp-footer">
	<div class="cnp-footer__inner">
		<div class="cnp-footer__brand">
			{% include 'components/brand.twig' %}
			<p class="cnp-footer__credit">
				{{ __('Created by', 'canopy') }}
				<a href="https://www.linkedin.com/in/gustavomunix/" rel="author noopener">Gustavo Muniz</a>
				{{ __('at', 'canopy') }}
				<a href="https://agenciaupgrade.com.br" rel="noopener">Agência Upgrade</a>
				<span aria-hidden="true">·</span>
				{{ "now"|date('Y') }}
			</p>
			{% if site.description %}
				<p class="cnp-footer__tagline">{{ site.description }}</p>
			{% endif %}
		</div>

		{% if footer_menu %}
			<nav class="cnp-footer__nav" aria-label="{{ __('Footer', 'canopy') }}">
				<ul class="cnp-footer__list">
					{% for item in footer_menu.items %}
						<li class="cnp-footer__item">
							<a href="{{ item.url|e('esc_url') }}" class="cnp-footer__link">{{ item.title }}</a>
						</li>
					{% endfor %}
				</ul>
			</nav>
		{% endif %}
	</div>

	{{ function('wp_footer') }}
</footer>
