# Canopy
# Agência Upgrade — https://agenciaupgrade.com.br

# Credentials — never commit
.env
.env.*
!.env.example
auth.json

# WordPress core — installed via Composer (roots/wordpress)
/web/wp

# Plugins — installed via Composer
/web/app/plugins/*
!/web/app/plugins/.gitkeep

# MU-plugins — installed via Composer (type:wordpress-muplugin → directory)
/web/app/mu-plugins/bedrock-disallow-indexing/

# Uploads and files generated by WordPress
/web/app/uploads/*
!/web/app/uploads/.gitkeep
/web/app/upgrade
/web/app/languages/
/web/app/litespeed/

# Twig cache
/web/app/themes/*/cache

# Mirrored third-party docs — kept locally for reference, not versioned
/docs/_vendor/

# PHP dependencies
/vendor

# Node dependencies (lint only, no build)
/node_modules/

# PHPStan cache
/tmp/

# Logs
*.log

# Agent / Claude local state. Only the Canopy, modern-css and
# modern-web-guidance skills are versioned.
/skills-lock.json
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/canopy/
!/.agents/skills/canopy/**
!/.agents/skills/modern-css/
!/.agents/skills/modern-css/**
!/.agents/skills/modern-web-guidance/
!/.agents/skills/modern-web-guidance/**
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/canopy
!/.claude/skills/canopy/**
!/.claude/skills/modern-css
!/.claude/skills/modern-web-guidance
.gemini/
.grok/
.codebuddy/
.cursor/
.qoder/
.kiro/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
# Added by code-review-graph
.code-review-graph/
